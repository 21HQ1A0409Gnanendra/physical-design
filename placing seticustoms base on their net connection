set offsetX   30.0
set colPitch  15.0
set rowPitch  15.0
 
#---------------------------------------------------
# Fixed LLX locations from core edge
#---------------------------------------------------
#---------------------------------------------------
# Fixed distance from CORE edge
#---------------------------------------------------
#set coreBBox [get_db current_design .core_bbox]
#set coreLLX  [lindex $coreBBox 0]
#
## Required distances from core edge
#set leftColX  [expr {$coreLLX + 80.94}]
#set rightColX [expr {$coreLLX + 102.60}]
 
 
set coreBBox [get_db current_design .core_bbox]
 
puts "coreBBox = $coreBBox"
 
set coreLLX [lindex [lindex $coreBBox 0] 0]
 
puts "coreLLX = $coreLLX"
 
set leftColX  [expr {double($coreLLX) + 80.94}]
set rightColX [expr {double($coreLLX) + 102.60}]
#---------------------------------------------------
# Align to nearest EVEN CPP
#---------------------------------------------------
set cpp 0.057
 
set cppIndex [expr {round($leftColX / $cpp)}]
set cppIndex [expr {2 * round($cppIndex / 2.0)}]
set leftColX [expr {$cppIndex * $cpp}]
 
set cppIndex [expr {round($rightColX / $cpp)}]
set cppIndex [expr {2 * round($cppIndex / 2.0)}]
set rightColX [expr {$cppIndex * $cpp}]
 
puts "Core LLX      = $coreLLX"
puts "Left Column X = $leftColX"
puts "Right Column X= $rightColX"
 
 
#---------------------------------------------------
# Placement
#---------------------------------------------------
set idx 0
 
foreach pair $cellNetPairs {
 
    set cellName [lindex $pair 0]
    set netName  [lindex $pair 1]
 
    if {[expr {$idx % 4}] == 0} {
 
        set bbox [get_db \
            [get_db nets .special_wires \
            -if ".obj_type == special_wire && .net == $netName"] .rect]
 
        set yMin [lindex [lindex $bbox 0] 1]
        set yMax [lindex [lindex $bbox 0] 3]
 
        set anchorY [expr {($yMin + $yMax)/2.0}]
    }
 
    set pos [expr {$idx % 4}]
 
    switch $pos {
        0 {
            set placeX $leftColX
            set placeY $anchorY
        }
        1 {
            set placeX $rightColX
            set placeY $anchorY
        }
        2 {
            set placeX $leftColX
            set placeY [expr {$anchorY - $rowPitch}]
        }
        3 {
            set placeX $rightColX
            set placeY [expr {$anchorY - $rowPitch}]
        }
    }
    place_inst $cellName $placeX $placeY R0
    incr idx
    eval_legacy refinePlace
}



