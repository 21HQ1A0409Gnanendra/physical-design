############################################################
# AP Layer Generation
#Taking regerence as right bump
############################################################

set apLayer AP

# Default AP dimensions
set AP_LEN_DEFAULT 89.2
set AP_LEN_SHORT   53.2
set AP_HEIGHT      5.4

# Number of AP shapes
set NUM_APS 445

# LLY-to-LLY spacing
set Y_PITCH 24.0

# AP indices requiring shorter length (40.3)

set shortAPs { 9 10 11 13 14 15 21 22 23 25 26 27 29 30 31 33 34 35 37 38 39 41 42 43 45 46 47 49 50 51 53 54 55 57 58 59 61 62 63 89 90 91 93 94 95 97 98 99 101 102 103 105 106 107 109 110 111 113 114 115 117 118 119 121 122 123 125 126 127 129 130 131 137 138 139 141 142 143 149 150 151 153 154 155 161 162 163 165 166 167 265 266 267 269 270 271 273 274 275 277 278 279 281 282 283 285 286 287 289 290 291 293 294 295 297 298 299 301 302 303 305 306 307 313 314 315 317 318 319 325 326 327 329 330 331 337 338 339 341 342 343 361 362 363 365 366 367 373 374 375 377 378 379 381 382 383 385 386 387 389 390 391 393 394 395 397 398 399 401 402 403 405 406 407 409 410 411 413 414 415 417 418 419 421 422 423 425 426 427 429 430 431 433 434 435 437 438 439}
# Starting bump locations
set bumpStarts {
    {260.9 10704.9 265.1 10709.1}
}

foreach bump $bumpStarts {

lassign $bump x1 y1 x4 y4
set y2 [expr $y4 + 0.6]
set x2 [expr $x4 + 0.5]
    # Start AP at bump LLX
    set urx $x2

    # First AP starts at bump LLY
    set first_ury $y2

    for {set i 0} {$i < $NUM_APS} {incr i} {

        # Use 40.3 length for selected AP numbers
        if {[lsearch -exact $shortAPs $i] >= 0} {
            set apLen $AP_LEN_SHORT
        } else {
            set apLen $AP_LEN_DEFAULT
        }

        set llx [expr {$urx - $apLen}]

        # 24um LLY-to-LLY spacing
        set ury [expr {$first_ury - ($i * $Y_PITCH)}]
        set lly [expr {$ury - $AP_HEIGHT}]

        create_shape \
            -layer $apLayer \
            -rect "$llx $lly $urx $ury" \
            -net VSS

        puts "Created AP $i : $llx $lly $urx $ury (Length=$apLen)"
    }
}

# Additional AP shapes


puts "================================================="
puts "AP Generation Completed"
puts "Total Shapes = [expr {[llength $bumpStarts] * $NUM_APS}]"
puts "================================================="
